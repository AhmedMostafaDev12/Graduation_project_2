# Copy to .env and fill in the secrets. Never commit .env.

# ----- App -----
ENVIRONMENT=local

# ----- Databases -----
# Day-to-day work: the local Docker Postgres (docker-compose.dev.yml, host port 5434).
DATABASE_URL=postgresql+psycopg://remori:remori@localhost:5434/remori
# Production: Supabase session pooler (IPv4) + sslmode=require. Only used on purpose. See docs/DATABASE.md.
SUPABASE_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require
# Database tests (pytest) use a separate local database.
TEST_DATABASE_URL=postgresql+psycopg://remori:remori@localhost:5434/remori_test
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# Login passwords for the database roles on Supabase.
REMORI_APP_DB_PASSWORD=<random>
REMORI_READONLY_DB_PASSWORD=<random>

# ----- Sign in with Google / Facebook (spec D26) -----
# Comma-separated OAuth client IDs whose Google ID tokens we accept (Android, iOS, web).
GOOGLE_CLIENT_IDS=<android-client-id>,<ios-client-id>,<web-client-id>
FACEBOOK_APP_ID=<facebook-app-id>
FACEBOOK_APP_SECRET=<facebook-app-secret>

# ----- Seed (test accounts on Supabase) -----
SEED_PASSWORD=<random>
SEED_DEVICE_TOKEN=<random>

# ----- AWS (the EC2 server uses its IAM role instead of keys) -----
AWS_REGION=eu-central-1
S3_BUCKET=remori-media-090413359449
